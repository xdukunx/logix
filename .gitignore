# ============================================================
# CRITICAL: these patterns prevent committing sensitive data.
# Logix processes student names, NIM, and client IPs. NONE of
# that runtime data may ever enter version control.
# ============================================================

# Claude Code local state — worktrees, job metadata, plans (never versioned)
.claude/

# Bundled third-party binaries + installer build output (not source)
installer/assets/*.exe
installer/Output/
windows/*.exe
windows/logo.png
# Generated mascot branding — rebuilt from installer/branding/mascot-source.*
installer/branding/wizard-image.bmp
installer/branding/wizard-small.bmp
installer/branding/logix.ico

# Databases — contain all PII (names, NIM, IPs, session records)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
logix.db

# Windows session state — contains live usernames / session payloads
session.json
*/MindLabLogbook/*
ProgramData/

# Generated reports — contain PII
*.xlsx
*.xls
reports/
output/

# Logs — may contain IPs, usernames, hostnames
*.log
logs/

# Local DB backups (contain the same PII as the DB — *.db already blocks these,
# listed explicitly for clarity)
backups/
server/backups/

# Google service-account credentials (for future GSheet sync)
# NEVER commit these — they grant write access to the sheet.
service_account.json
*service-account*.json
credentials.json
client_secret*.json
config.env
*.env
!*.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# --- Additive hardening (batch 1) ---------------------------------------
# Server runtime + editor/OS cruft. The patterns above already block *.db,
# *.env, credentials, reports, and logs; these are belt-and-suspenders.
server/central_logix.db
server/reports/
# Runtime-generated admin config (branding/popup/report/privacy settings).
# Written automatically from DEFAULT_CONFIG in server/main.py on first
# startup, then edited live via the Settings tab -- mutable runtime state,
# not source, same category as the database above.
server/server_config.json
*.token
.DS_Store
Thumbs.db
node_modules/
.idea/
.vscode/
frontend/dist/

# Generated by ops/go_live.py -- real secrets and live data, never commit.
server/.env.production
server/central_logix*.db

# Playwright output -- regenerated by ops/demo.py.
frontend/playwright-report/
frontend/test-results/
# Ad-hoc diagnostic screenshots. These capture the live dashboard, which
# means real student names and NIMs -- exactly what CLAUDE_CODE_HANDOFF.md
# forbids committing.
frontend/diagnose-*.png
