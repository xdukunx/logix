# Logix config — copy to config.env (gitignored), fill in. NEVER commit config.env.
# Parsed directly by logix/paths.py on every OS; the `export` prefix is optional
# (it's ignored) so the same file works under bash and on native Windows.
# The installer writes one of these for you — you usually don't edit it by hand.
#
# LOGIX_HOME sets the base dir; LOGIX_DB / LOGBOOK_REPORT_DIR override individually.
# Defaults if unset: /opt/software/logix (Linux), /Library/Application Support/Logix
# (macOS), C:\ProgramData\Logix (Windows).
LOGIX_HOME="/opt/software/logix"
# export LOGIX_DB="/opt/software/logix/logix.db"

# Future GSheet sync (not yet implemented — see docs/GSHEET_SYNC_DESIGN.md)
# export LOGIX_GSHEET_ID="your-spreadsheet-id"
# export LOGIX_GSHEET_CREDS="/secure/path/service_account.json"
# export LOGIX_REDACT_MODE="initials"
