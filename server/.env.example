# ============================================================================
# Logix central server — environment variables (PREVIEW component).
# Copy to a private location and load before starting the server. NEVER commit
# a filled-in copy. See SECURITY.md for the current hardening status.
# ============================================================================

# --- Admin allowlist ------------------------------------------------------
# Comma-separated list of admin emails permitted to sign in. An email may
# carry a role, e.g. "boss@lab.ac.id:super_admin, ta@lab.ac.id:viewer".
ADMIN_EMAILS="admin@example.org"

# --- Admin password (REQUIRED for real authentication) -------------------
# Login is email + password (Google OAuth was removed). Set ONE shared admin
# password here; anyone on ADMIN_EMAILS above signs in with it. Use a STRONG
# value (not "admin123") -- this is the only thing between the internet and
# the dashboard. If EMPTY in production (LOGIX_DEV_MODE=0), login is disabled
# entirely (no backdoor). In dev mode an unset password defaults to "admin123".
# Kept only here / in your private .env -- never committed (*.env is gitignored).
LOGIX_ADMIN_PASSWORD=""

# --- Ingest API key -------------------------------------------------------
# Shared secret that local agents send as the X-API-Key header when pushing
# logs/heartbeats. Set this and configure the same value on each agent via
# LOGIX_SERVER_API_KEY. (Server-side enforcement is roadmap item C.)
LOGIX_INGEST_API_KEY=""

# --- Deployment mode ------------------------------------------------------
# 0 = production posture (no mock auth, strict CORS). 1 = local development.
# Default to 0 for anything not on your own laptop.
LOGIX_DEV_MODE="0"

# --- Allowed browser origins for the dashboard (production) --------------
# Comma-separated list. Used when LOGIX_DEV_MODE=0 instead of a wildcard.
LOGIX_ALLOWED_ORIGINS="http://localhost:8000"

# --- Ops watchdog alerts (optional) --------------------------------------
# Used by ops/watchdog.py to send Telegram alerts when the server is down,
# errors pile up in logix.log, or backups go stale. Create a bot via
# @BotFather to get the token; get your chat id from @userinfobot. Leave
# blank to disable alerting. See docs/RUNBOOK.md.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
