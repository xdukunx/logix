{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/your-org/logix/docs/config.schema.json",
  "title": "Logix branding & UI configuration",
  "description": "Shared configuration consumed by the Windows sign-in popup, the central server, and the admin dashboard. All keys are optional; anything omitted falls back to built-in defaults. Copy windows/logbook_config.example.json or server/server_config.json and edit — never hardcode branding in source.",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Free-text note; ignored by all consumers."
    },
    "branding": {
      "type": "object",
      "description": "Visual identity shared across popup, dashboard, and reports.",
      "properties": {
        "logoText": { "type": "string", "description": "Short text logo shown when no image is set." },
        "logoPath": { "type": "string", "description": "Absolute path to a logo image (optional)." },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "colors": {
          "type": "object",
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "accent":  { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "muted":   { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "text":    { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "description": "All user-facing labels and hint strings. Localize here without touching code.",
      "properties": {
        "intro": { "type": "string" },
        "startHint": { "type": "string" },
        "namaLabel": { "type": "string" },
        "nimLabel": { "type": "string" },
        "accessLabel": { "type": "string" },
        "purposeLabel": { "type": "string" },
        "ketLabel": { "type": "string" },
        "submit": { "type": "string" },
        "hint": { "type": "string" },
        "hintIncomplete": { "type": "string" },
        "hintReady": { "type": "string" }
      },
      "additionalProperties": true
    },
    "accessTypes": {
      "type": "array",
      "description": "Options for the access-type dropdown.",
      "items": { "type": "string" }
    },
    "purposes": {
      "type": "array",
      "description": "Options for the session-purpose dropdown.",
      "items": { "type": "string" }
    },
    "requiredFields": {
      "type": "array",
      "description": "Which form fields must be filled before a session can start.",
      "items": {
        "type": "string",
        "enum": ["nama", "nim", "access", "purpose", "keterangan"]
      }
    },

    "product": {
      "type": "string",
      "description": "OPTIONAL (roadmap): product/app name for full rebranding."
    },
    "organization": {
      "type": "string",
      "description": "OPTIONAL (roadmap): deploying organization name."
    },
    "device": {
      "type": "object",
      "description": "OPTIONAL (roadmap): per-device enrollment defaults. See docs/AUDIT_AND_ROADMAP.md.",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["lab_workstation", "office_workstation", "loaned_laptop", "mobile_device", "server", "custom"]
        },
        "displayName": { "type": "string" },
        "location": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "privacyMode": {
      "type": "string",
      "description": "OPTIONAL (roadmap): default privacy posture for this device.",
      "enum": ["local_only", "redacted_sync", "admin_full_sync"],
      "default": "local_only"
    }
  },
  "additionalProperties": false
}
